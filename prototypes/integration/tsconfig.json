{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "esModuleInterop": true, "skipLibCheck": false,
    "baseUrl": ".",
    "paths": {
      "css-tree": ["node_modules/@types/css-tree"],
      "dexie": ["node_modules/dexie"],
      "jszip": ["node_modules/jszip"],
      "openapi-fetch": ["node_modules/openapi-fetch"]
    },
    "types": ["node"]
  },
  "include": ["src", "tests", "vite.config.ts", "playwright.config.ts"]
}
