FROM --platform=$BUILDPLATFORM node:22.23.4 AS frontend
WORKDIR /src
COPY web/package.json web/package-lock.json ./web/
RUN --mount=type=cache,target=/root/.npm npm --prefix web ci
COPY web ./web
COPY api/app-navigation.regexp ./api/app-navigation.regexp
COPY assets/manifest.json ./assets/manifest.json
RUN npm --prefix web run build && test -s assets/app/index.html && test -s assets/app/sw.js && test -s assets/app/manifest.json

FROM alpine AS alpine
RUN apk add --no-cache ca-certificates tzdata

FROM --platform=$BUILDPLATFORM golang:1.26.11 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg go mod download
COPY . .
COPY --from=frontend /src/assets/app ./assets/app
ARG TARGETOS
ARG TARGETARCH
ARG VERSION=release
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg \
    CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -mod=readonly \
      -ldflags "-X reichard.io/antholume/config.version=$VERSION" -o /opt/antholume/server

FROM busybox:1.36
COPY --from=alpine /etc/ssl/certs /etc/ssl/certs
COPY --from=alpine /usr/share/zoneinfo /usr/share/zoneinfo
COPY --from=build /opt/antholume /opt/antholume
WORKDIR /opt/antholume
EXPOSE 8585
ENTRYPOINT ["/opt/antholume/server", "serve"]
